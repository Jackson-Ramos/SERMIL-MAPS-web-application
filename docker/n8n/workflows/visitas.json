        "query": "=INSERT INTO visitas (cond_id, lote_id, cpf, nome_visitante, quadra, lote, app_navegacao, status, rota, porteiro_id) VALUES ({{ $json.body.cond_id }}, {{ $json.body.lote_id }}, '{{ $json.body.cpf }}', {{ $json.body.nome_visitante ? `'${$json.body.nome_visitante}'` : 'NULL' }}, '{{ $json.body.quadra }}', '{{ $json.body.lote }}', '{{ $json.body.app_navegacao ?? 'interno' }}', 'ativa', {{ $json.body.rota ? `'${JSON.stringify($json.body.rota)}'` : 'NULL' }}, {{ $json.body.porteiro_id ?? 'NULL' }})",
        "options": {}
      },
      "credentials": {
        "oracleDb": {
          "id": "ORACLE_CREDENTIAL_ID",
          "name": "Oracle SERMIL"
        }
