    {
      "id": "vis-oracle-select-new",
      "name": "Oracle SELECT Nova Visita",
      "type": "n8n-nodes-base.oracleDatabase",
      "typeVersion": 1,
      "position": [720, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id, cond_id, lote_id, cpf, nome_visitante, quadra, lote, TO_CHAR(horario_entrada, 'YYYY-MM-DD\"T\"HH24:MI:SS\"Z\"') AS horario_entrada, horario_saida, duracao_minutos, app_navegacao, status, rota, observacoes, porteiro_id FROM visitas WHERE lote_id = {{ $('POST Iniciar Visita').first().json.body.lote_id }} AND cpf = '{{ $('POST Iniciar Visita').first().json.body.cpf }}' AND status = 'ativa' AND ROWNUM = 1 ORDER BY horario_entrada DESC",
        "options": {}
      },
