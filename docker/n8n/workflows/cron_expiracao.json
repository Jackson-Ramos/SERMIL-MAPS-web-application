{
  "name": "SERMIL — Cron Expiração",
  "nodes": [
    {
      "id": "cron-trigger",
      "name": "Cron 5 Minutos",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      }
    },

    {
      "id": "cron-oracle-expire-visitas",
      "name": "Oracle EXPIRE Visitas",
      "type": "n8n-nodes-base.oracleDatabase",
      "typeVersion": 1,
      "position": [460, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE visitas v SET v.status = 'expirada' WHERE v.status = 'ativa' AND v.horario_entrada < SYSTIMESTAMP - (SELECT NUMTODSINTERVAL(c.tempo_maximo_visita, 'MINUTE') FROM configuracoes c WHERE c.cond_id = v.cond_id AND c.expiracao_automatica_ativa = 1)",
        "options": {}
      },
      "credentials": {
        "oracleDb": {
          "id": "ORACLE_CREDENTIAL_ID",
          "name": "Oracle SERMIL"
        }
      }
    },

    {
      "id": "cron-oracle-expire-qr",
      "name": "Oracle EXPIRE QRCodes",
      "type": "n8n-nodes-base.oracleDatabase",
      "typeVersion": 1,
      "position": [720, 300],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE qr_codes SET ativo = 0 WHERE ativo = 1 AND expira_em IS NOT NULL AND expira_em <= SYSTIMESTAMP",
        "options": {}
      },
      "credentials": {
        "oracleDb": {
          "id": "ORACLE_CREDENTIAL_ID",
          "name": "Oracle SERMIL"
        }
      }
    },

    {
      "id": "cron-log",
      "name": "Log Execucao",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [980, 300],
      "parameters": {}
    }
  ],
  "connections": {
    "Cron 5 Minutos":         { "main": [[{ "node": "Oracle EXPIRE Visitas", "type": "main", "index": 0 }]] },
    "Oracle EXPIRE Visitas":  { "main": [[{ "node": "Oracle EXPIRE QRCodes", "type": "main", "index": 0 }]] },
    "Oracle EXPIRE QRCodes":  { "main": [[{ "node": "Log Execucao",          "type": "main", "index": 0 }]] }
  },
  "active": true,
  "settings": { "executionOrder": "v1" },
  "tags": [{ "name": "sermil" }, { "name": "cron" }]
}
