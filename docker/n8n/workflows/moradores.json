      "id": "mor-oracle-list",
      "name": "Oracle SELECT Moradores",
      "type": "n8n-nodes-base.oracleDatabase",
      "typeVersion": 1,
      "position": [460, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT m.id, m.lote_id, m.nome, m.cpf, m.ramal, m.user_id, m.total_visitas, q.nome AS quadra, l.numero AS lote FROM moradores m JOIN lotes l ON l.id = m.lote_id JOIN quadras q ON q.id = l.quadra_id WHERE q.cond_id = {{ $json.body.cond_id }} ORDER BY m.nome ASC",
        "options": {}
      },
      "credentials": {
        "oracleDb": {
          "id": "ORACLE_CREDENTIAL_ID",
          "name": "Oracle SERMIL"
        }
      }
    },
