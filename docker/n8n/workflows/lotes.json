{
  "name": "SERMIL — Lotes",
  "nodes": [
    {
      "id": "lote-wh-list",
      "name": "GET Lotes",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 200],
      "parameters": {
        "httpMethod": "POST",
        "path": "lotes/list",
        "responseMode": "responseNode",
        "options": {}
      },
      "webhookId": "lote-wh-list-id"
    },
    {
      "id": "lote-oracle-list",
      "name": "Oracle SELECT Lotes",
      "type": "n8n-nodes-base.oracleDatabase",
      "typeVersion": 1,
      "position": [460, 200],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT l.id, l.quadra_id, l.numero, l.latitude, l.longitude, m.nome AS nome_morador, m.ramal FROM lotes l LEFT JOIN moradores m ON m.lote_id = l.id WHERE l.quadra_id = {{ $json.body.quadra_id }} ORDER BY l.numero ASC",
        "options": {}
      },
      "credentials": {
        "oracleDb": {
          "id": "ORACLE_CREDENTIAL_ID",
          "name": "Oracle SERMIL"
        }
      }
    },
    {
      "id": "lote-respond-list",
      "name": "Respond GET Lotes",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [720, 200],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}"
      }
    },

    {
      "id": "lote-wh-create",
      "name": "POST Lote",
      "type": "n8n-nodes-base.webhook",
