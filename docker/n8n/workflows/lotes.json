      "typeVersion": 1,
      "position": [460, 420],
      "parameters": {
        "operation": "executeQuery",
        "query": "=INSERT INTO lotes (quadra_id, numero, latitude, longitude) VALUES ({{ $json.body.quadra_id }}, '{{ $json.body.numero }}', {{ $json.body.latitude ?? 'NULL' }}, {{ $json.body.longitude ?? 'NULL' }})",
        "options": {}
      },
      "credentials": {
        "oracleDb": {
          "id": "ORACLE_CREDENTIAL_ID",
          "name": "Oracle SERMIL"
        }
      }
    },
    {
      "id": "lote-oracle-select-new",
      "name": "Oracle SELECT Novo Lote",
      "type": "n8n-nodes-base.oracleDatabase",
      "typeVersion": 1,
      "position": [720, 420],
      "parameters": {
        "operation": "executeQuery",
        "query": "=SELECT id, quadra_id, numero, latitude, longitude FROM lotes WHERE quadra_id = {{ $('POST Lote').first().json.body.quadra_id }} AND numero = '{{ $('POST Lote').first().json.body.numero }}'",
        "options": {}
      },
      "credentials": {
        "oracleDb": {
          "id": "ORACLE_CREDENTIAL_ID",
          "name": "Oracle SERMIL"
        }
      }
    },
