# =============================================================================
# SERMIL MAPS — Variáveis de Ambiente
# Copie este arquivo para .env antes de rodar a aplicação:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Backend (porta padrão 5000)
# JWT_SECRET    → segredo de assinatura dos tokens JWT (altere em produção!)
# COND_ID       → ID do condomínio padrão (seed = 1)
# FRONTEND_URL  → origem permitida no CORS (e base do link de QR Codes)
# -----------------------------------------------------------------------------
PORT=5000
JWT_SECRET=sermil-jwt-secret-altere-em-producao
COND_ID=1
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# Frontend (Vite — variáveis de build)
# -----------------------------------------------------------------------------
VITE_USE_MOCK=false
VITE_API_URL=http://localhost:5000/api
VITE_COND_ID=1
