# =============================================================================
# SERMIL MAPS — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes de rodar o stack.
#
#   cp .env.example .env
#
# NUNCA commite o .env com valores reais no git.
# =============================================================================

# -----------------------------------------------------------------------------
# Oracle XE
# ORACLE_SYS_PASSWORD  → senha dos usuários SYS e SYSTEM (interno ao Oracle)
# ORACLE_APP_USER      → usuário da aplicação criado automaticamente no XEPDB1
# ORACLE_APP_PASSWORD  → senha do usuário da aplicação
# -----------------------------------------------------------------------------
ORACLE_SYS_PASSWORD=SermilOracle1234
ORACLE_APP_USER=sermil
ORACLE_APP_PASSWORD=SermilApp1234

# -----------------------------------------------------------------------------
# n8n
# N8N_USER / N8N_PASSWORD  → credenciais do painel admin em http://localhost:5678
# N8N_WEBHOOK_SECRET       → chave compartilhada entre backend e n8n
#                            (altere para um valor aleatório longo em produção)
# -----------------------------------------------------------------------------
N8N_USER=admin
N8N_PASSWORD=n8nAdmin123
N8N_WEBHOOK_SECRET=sermil-n8n-secret-key-altere-em-producao

# -----------------------------------------------------------------------------
# Backend
# JWT_SECRET  → segredo de assinatura dos tokens JWT
#               (altere para um valor aleatório longo em produção)
# COND_ID     → ID do condomínio padrão (inserido no seed como id=1)
# -----------------------------------------------------------------------------
JWT_SECRET=sermil-jwt-secret-altere-em-producao
COND_ID=1
